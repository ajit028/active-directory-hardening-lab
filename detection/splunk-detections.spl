/* ============================================================================
// SPLUNK SPL DETECTION QUERIES
// Active Directory Security Auditing & Hardening Lab
// Author: Ajit Nayak (https://ajit028.github.io)
// ============================================================================
*/

/*
// ────────────────────────────────────────────────────────────────────────────
// Rule 1: Kerberoasting Detection (RC4 TGS Requests - Event ID 4769)
// MITRE ATT&CK: T1558.003
// ────────────────────────────────────────────────────────────────────────────
*/
index=wineventlog source="WinEventLog:Security" EventCode=4769 Ticket_Encryption_Type="0x17"
| search Service_Name!="*$" AND Service_Name!="krbtgt" AND Service_Name!="kadmin/changepw"
| bucket _time span=10m
| stats count as RequestCount, values(Service_Name) as TargetServices, min(_time) as FirstSeen by Source_Network_Address, Account_Name, _time
| where RequestCount >= 3
| eval Severity="High", MITRE_Technique="T1558.003"
| table FirstSeen, Source_Network_Address, Account_Name, RequestCount, TargetServices, Severity


/*
// ────────────────────────────────────────────────────────────────────────────
// Rule 2: AS-REP Roasting Detection (Event ID 4768 with PreAuth Type 0)
// MITRE ATT&CK: T1558.004
// ────────────────────────────────────────────────────────────────────────────
*/
index=wineventlog source="WinEventLog:Security" EventCode=4768 Pre_Authentication_Type="0x0" Status="0x0"
| stats count, min(_time) as TimeGenerated by ComputerName, Account_Name, Source_Network_Address, Pre_Authentication_Type, Status
| eval Severity="High", MITRE_Technique="T1558.004"
| table TimeGenerated, ComputerName, Account_Name, Source_Network_Address, Pre_Authentication_Type, Severity


/*
// ────────────────────────────────────────────────────────────────────────────
// Rule 3: Abnormal TGS Request Volume (Potential Automated Scraping)
// MITRE ATT&CK: T1558.003 / T1087.002
// ────────────────────────────────────────────────────────────────────────────
*/
index=wineventlog source="WinEventLog:Security" EventCode=4769
| search Service_Name!="*$"
| bucket _time span=5m
| stats count as TotalTickets, dc(Service_Name) as UniqueServices by Account_Name, Source_Network_Address, _time
| where TotalTickets > 20 OR UniqueServices > 10
| eval Severity="Medium", MITRE_Technique="T1558.003"
| table _time, Account_Name, Source_Network_Address, TotalTickets, UniqueServices, Severity


/*
// ────────────────────────────────────────────────────────────────────────────
// Rule 4: Golden Ticket Detection (Abnormal Lifetime / Invalid KRBTGT Request)
// MITRE ATT&CK: T1558.001
// ────────────────────────────────────────────────────────────────────────────
*/
index=wineventlog source="WinEventLog:Security" EventCode=4769 Service_Name="krbtgt"
| search Ticket_Options="*0x40810000*" OR Ticket_Options="*0x40800000*"
| stats count min(_time) as TimeGenerated by Account_Name, Source_Network_Address, Service_Name, Ticket_Options, Ticket_Encryption_Type
| eval Severity="Critical", MITRE_Technique="T1558.001"
| table TimeGenerated, Account_Name, Source_Network_Address, Service_Name, Ticket_Options, Severity


/*
// ────────────────────────────────────────────────────────────────────────────
// Rule 5: DCSync Detection (Directory Service Replication - Event ID 4662)
// MITRE ATT&CK: T1003.006
// ────────────────────────────────────────────────────────────────────────────
*/
index=wineventlog source="WinEventLog:Security" EventCode=4662 "*1131f6aa-9c07-11d1-f79f-00c04fc2dcd2*"
| search Account_Name!="*$" Account_Name!="SYSTEM" Account_Name!="ANONYMOUS LOGON"
| bucket _time span=1h
| stats count as EventCount min(_time) as FirstSeen by Account_Name, Source_Network_Address, ComputerName, _time
| eval Severity="Critical", MITRE_Technique="T1003.006"
| table FirstSeen, Account_Name, Source_Network_Address, ComputerName, EventCount, Severity
